{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"xuong-truyen-ai",
  "main":"worker/index.mjs",
  "compatibility_date":"2026-10-02",
  "compatibility_flags":["nodejs_compat"],
  "assets":{"directory":".","run_worker_first":["/api/*"],"not_found_handling":"single-page-application"},
  "durable_objects":{"bindings":[{"name":"JOBS","class_name":"JobDO"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["JobDO"]}],
  "vars":{"DEFAULT_MODEL":"deepseek/deepseek-v3.2","JOB_TTL_HOURS":"48"},
  "observability":{"enabled":true}
}
